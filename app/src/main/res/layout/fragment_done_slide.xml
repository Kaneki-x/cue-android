<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/intro_done_title"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.Cue.Display" />

        <!-- Where to find what the welcome slide promised: the keyboard, the widget and backups -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_outline_keyboard_24"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cue_space_4"
                android:layout_weight="1"
                android:minHeight="24dp"
                android:gravity="center_vertical"
                android:text="@string/intro_tip_keyboard"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cue_space_4"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_cue_logo_small" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cue_space_4"
                android:layout_weight="1"
                android:minHeight="24dp"
                android:gravity="center_vertical"
                android:text="@string/intro_tip_widget"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cue_space_4"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_outline_cloud_upload_24"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cue_space_4"
                android:layout_weight="1"
                android:minHeight="24dp"
                android:gravity="center_vertical"
                android:text="@string/intro_tip_backup"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
