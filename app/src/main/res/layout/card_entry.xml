<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="0dp"
    android:clickable="true"
    android:focusable="true"
    android:checkable="true"
    app:checkedIcon="@null"
    app:cardElevation="0dp"
    style="@style/Widget.Cue.EntryCardView">

    <!-- pinned: the bar on the card's left edge, as in the other view modes and on iOS; the
         card's rounded corners clip it to a 4dp strip -->
    <View
        android:id="@+id/favorite_indicator"
        android:layout_width="15dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginStart="-11dp"
        android:background="@drawable/favorite_indicator"
        android:backgroundTint="?attr/colorFavorite"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/rlCardEntry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/cue_space_4"
        android:paddingTop="@dimen/cue_space_4"
        android:paddingEnd="@dimen/cue_space_4"
        android:paddingBottom="@dimen/cue_space_4">

        <!-- Row 1: who this entry is for -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivTextDrawable"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Cue.ImageView.Circle" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivSelected"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/item_selected"
                    android:visibility="gone"
                    android:background="?attr/colorPrimaryAlternative"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Cue.ImageView.Circle" />
            </FrameLayout>

            <!-- description and the "Copied" label share this slot; the holder cross-fades them -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cue_space_3"
                android:layout_weight="1">

                <RelativeLayout
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/profile_issuer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/issuer"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/profile_account_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/profile_issuer"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        tools:text=" (AccountName)" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/profile_copied"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/copied"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="invisible" />
            </FrameLayout>

            <ImageView
                android:id="@+id/drag_handle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/cue_space_2"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/ic_outline_menu_24"
                android:visibility="invisible"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Row 2: the code and how long it lasts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cue_space_3"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/profile_codes_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fallbackLineSpacing="false"
                    android:includeFontPadding="false"
                    android:layoutDirection="ltr"
                    android:textAppearance="@style/TextAppearance.Cue.Code.Display"
                    tools:text="012 345" />

                <TextView
                    android:id="@+id/next_profile_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cue_space_1"
                    android:fallbackLineSpacing="false"
                    android:includeFontPadding="false"
                    android:layoutDirection="ltr"
                    android:textAppearance="@style/TextAppearance.Cue.Code.Inline"
                    android:textColor="?attr/colorOnSurfaceDim"
                    android:visibility="gone"
                    tools:text="678 901"
                    tools:visibility="visible" />
            </LinearLayout>

            <ImageView
                android:id="@+id/buttonRefresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cue_space_2"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/action_refresh_code"
                android:focusable="true"
                android:padding="@dimen/cue_space_2"
                android:src="@drawable/ic_outline_refresh_24"
                android:visibility="gone"
                app:tint="?attr/colorOnSurface" />

            <io.cueapp.android.ui.views.TotpProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="@dimen/cue_ring_list"
                android:layout_height="@dimen/cue_ring_list"
                android:layout_marginStart="@dimen/cue_space_2"
                android:max="5000"
                android:progressDrawable="@drawable/progress_ring"
                android:rotation="-90" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
