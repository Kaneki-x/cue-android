<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context="com.beemdevelopment.aegis.ui.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@+id/rvKeyProfiles">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:logo="@drawable/ic_cue_logo_toolbar"
            app:titleMarginStart="@dimen/cue_space_3"
            app:titleTextAppearance="@style/TextAppearance.Cue.Wordmark" />

        <!-- always shown under the toolbar while the vault has entries, as on iOS
             (ContentView.searchField); filters as you type -->
        <LinearLayout
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/cue_space_2"
            android:layout_marginTop="@dimen/cue_space_1"
            android:layout_marginEnd="@dimen/cue_space_2"
            android:layout_marginBottom="@dimen/cue_space_1"
            android:background="@drawable/cue_search_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/cue_space_4"
            android:paddingEnd="@dimen/cue_space_3"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_outline_search_24"
                app:tint="?attr/colorOnSurfaceVariant" />

            <EditText
                android:id="@+id/search_field"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/cue_space_2"
                android:background="@null"
                android:hint="@string/search"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/search_clear"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear_search"
                android:src="@drawable/ic_filled_cancel_24"
                android:visibility="gone"
                app:tint="?attr/colorOutline" />
        </LinearLayout>

        <!-- a failed backup or changes not backed up, between the search field and the group
             chips as on iOS (ContentView.backupBanner); was a card at the top of the list -->
        <LinearLayout
            android:id="@+id/backup_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cue_space_2"
            android:layout_marginTop="@dimen/cue_space_1"
            android:layout_marginEnd="@dimen/cue_space_2"
            android:layout_marginBottom="@dimen/cue_space_1"
            android:background="@drawable/cue_banner_background"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/cue_space_4"
            android:paddingTop="@dimen/cue_space_3"
            android:paddingEnd="@dimen/cue_space_3"
            android:paddingBottom="@dimen/cue_space_3"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/backup_banner_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_outline_error_24" />

            <TextView
                android:id="@+id/backup_banner_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/cue_space_2"
                android:layout_marginEnd="@dimen/cue_space_2"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="数据库最近备份失败" />

            <TextView
                android:id="@+id/backup_banner_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                tools:text="查看" />

            <ImageView
                android:id="@+id/backup_banner_chevron"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_outline_chevron_right_24" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/groupChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"/>
            </LinearLayout>
        </HorizontalScrollView>
    </com.google.android.material.appbar.AppBarLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <fragment
            android:id="@+id/key_profiles"
            android:name="com.beemdevelopment.aegis.ui.views.EntryListView"
            android:layout_width="match_parent"
            android:layout_height="fill_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
