<?xml version="1.0" encoding="utf-8"?>
<!-- One entry as a key: a small tile like the 瓷贴 card. Issuer and account on top, the
     code, 推荐 and the ring below; the row clips the pinned bar to its corners. The iOS
     keyboard (apple/CueKeyboard) draws the same key, without 推荐 (it cannot see the app).
     Heights are minimums, so large font sizes make the key taller instead of clipping its
     text. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp"
    android:layout_margin="3dp"
    android:background="@drawable/ime_key_background"
    android:clickable="true"
    android:focusable="true">

    <!-- the bar is the only visual mark of a pinned entry, so screen readers say it -->
    <View
        android:id="@+id/favorite_indicator"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorFavorite"
        android:contentDescription="@string/entry_pinned"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="60dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Cue.ImageView.Circle"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

            <!-- the issuer first, the account name ellipsizing in what is left (KeyTitleLayout) -->
            <io.cueapp.android.ime.KeyTitleLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/issuer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="GitHub" />

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    tools:text="alex@example.com" />
            </io.cueapp.android.ime.KeyTitleLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- the code is measured first, so 推荐 gives way to it, never the other way -->
            <TextView
                android:id="@+id/code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cue_display"
                android:includeFontPadding="false"
                android:layoutDirection="ltr"
                android:maxLines="1"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="123 456" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/suggested"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/cue_pill_background"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="5dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="5dp"
                    android:paddingBottom="2dp"
                    android:text="@string/ime_suggested"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp">

                <io.cueapp.android.ime.CountdownRingView
                    android:id="@+id/ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/hotp_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_outline_refresh_24"
                    android:tint="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
